<?xml version="1.0" encoding="utf-8"?><!--
    The same decision as data_extraction_rules.xml, for Android 11 and below
    (API 30 and under), which uses this older format instead.

    Keep the two in step: the journal and the user's settings travel, nothing
    else does.
-->
<full-backup-content>
    <!-- Tour journal, visited places, cached stories -->
    <include
        domain="database"
        path="gpstracker_database" />
    <!-- Voice, tour and map preferences (DataStore) -->
    <include
        domain="file"
        path="datastore" />
</full-backup-content>
