<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/map_layers_title"
        android:textAppearance="?attr/textAppearanceHeadline6" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/map_style"
        android:textAppearance="?attr/textAppearanceSubtitle2" />

    <!-- OpenFreeMap styles (OpenStreetMap provider) -->
    <RadioGroup
        android:id="@+id/rg_map_style"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/rb_map_default"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/map_style_default" />

        <RadioButton
            android:id="@+id/rb_map_bright"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/map_style_bright" />

        <RadioButton
            android:id="@+id/rb_map_minimal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/map_style_minimal" />

        <RadioButton
            android:id="@+id/rb_map_dark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/map_style_dark" />
    </RadioGroup>

    <!-- Google map types (Google provider); hidden otherwise -->
    <RadioGroup
        android:id="@+id/rg_map_style_google"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <RadioButton
            android:id="@+id/rb_gmap_default"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/map_style_default" />

        <RadioButton
            android:id="@+id/rb_gmap_satellite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/map_style_satellite" />

        <RadioButton
            android:id="@+id/rb_gmap_terrain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/map_style_terrain" />
    </RadioGroup>

    <TextView
        android:id="@+id/tv_map_details_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/map_details"
        android:textAppearance="?attr/textAppearanceSubtitle2"
        android:visibility="gone" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switch_traffic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/map_traffic"
        android:visibility="gone" />

</LinearLayout>
