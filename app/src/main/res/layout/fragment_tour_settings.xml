<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tour_settings_title"
            android:textAppearance="?attr/textAppearanceHeadline5"
            android:layout_marginBottom="16dp" />

        <!-- Content Preferences Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/content_preferences"
            android:textAppearance="?attr/textAppearanceHeadline6"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/poi_categories" />

        <CheckBox
            android:id="@+id/cb_category_historical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/category_historical" />

        <CheckBox
            android:id="@+id/cb_category_cultural"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/category_cultural" />

        <CheckBox
            android:id="@+id/cb_category_natural"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/category_natural" />

        <CheckBox
            android:id="@+id/cb_category_architectural"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/category_architectural" />

        <CheckBox
            android:id="@+id/cb_category_entertainment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/category_entertainment" />

        <CheckBox
            android:id="@+id/cb_category_dining"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/category_dining" />

        <CheckBox
            android:id="@+id/cb_category_shopping"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/category_shopping" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/content_detail_level"
            android:layout_marginTop="8dp" />

        <RadioGroup
            android:id="@+id/rg_detail_level"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <RadioButton
                android:id="@+id/rb_detail_brief"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/detail_brief"
                android:layout_weight="1" />

            <RadioButton
                android:id="@+id/rb_detail_medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/detail_medium"
                android:checked="true"
                android:layout_weight="1" />

            <RadioButton
                android:id="@+id/rb_detail_detailed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/detail_detailed"
                android:layout_weight="1" />
        </RadioGroup>

        <!-- Audio Settings Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/audio_settings"
            android:textAppearance="?attr/textAppearanceHeadline6"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_audio_enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/audio_narration_enabled"
            android:checked="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/voice_speed"
            android:layout_marginTop="8dp" />

        <SeekBar
            android:id="@+id/seekbar_voice_speed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="20"
            android:progress="10" />

        <TextView
            android:id="@+id/tv_voice_speed_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            tools:text="1.0x" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/voice_pitch"
            android:layout_marginTop="8dp" />

        <SeekBar
            android:id="@+id/seekbar_voice_pitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="20"
            android:progress="10" />

        <TextView
            android:id="@+id/tv_voice_pitch_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            tools:text="1.0x" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_auto_play"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auto_play_content"
            android:checked="true"
            android:layout_marginTop="8dp" />

        <!-- Notification Settings Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/notification_settings"
            android:textAppearance="?attr/textAppearanceHeadline6"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/notification_distance" />

        <SeekBar
            android:id="@+id/seekbar_notify_distance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="500"
            android:progress="200" />

        <TextView
            android:id="@+id/tv_notify_distance_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            tools:text="660 ft" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/max_notifications_per_hour"
            android:layout_marginTop="8dp" />

        <SeekBar
            android:id="@+id/seekbar_max_notifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="30"
            android:progress="10" />

        <TextView
            android:id="@+id/tv_max_notifications_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            tools:text="10 per hour" />

        <!-- Battery Usage Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/battery_usage"
            android:textAppearance="?attr/textAppearanceHeadline6"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_prefetch_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/prefetch_content"
            android:checked="true" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_use_mobile_data"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/use_mobile_data"
            android:checked="false"
            android:layout_marginTop="8dp" />

        <!-- Map Provider Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/map_provider_title"
            android:textAppearance="?attr/textAppearanceHeadline6"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rg_map_provider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rb_provider_osm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/map_provider_osm" />

            <RadioButton
                android:id="@+id/rb_provider_google"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/map_provider_google" />
        </RadioGroup>

        <TextView
            android:id="@+id/tv_provider_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/map_provider_google_needs_key"
            android:textAppearance="?attr/textAppearanceCaption"
            android:visibility="gone" />

        <!-- Ads Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ads_section"
            android:textAppearance="?attr/textAppearanceHeadline6"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_ad_privacy"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ad_privacy_options" />

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp">

            <Button
                android:id="@+id/btn_cancel"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel_button"
                android:layout_weight="1"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/save"
                android:layout_weight="1"
                android:layout_marginStart="8dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
